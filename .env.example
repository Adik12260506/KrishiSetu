# KrishiSetu (FS-2604) Real SMS OTP Gateway Configuration
# Choose your preferred SMS provider or leave blank to use the built-in development simulator

# Option 1: TWILIO (Global & India SMS)
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option 2: FAST2SMS (India Quick SMS / OTP)
# Get API key from https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# Option 3: 2FACTOR.IN (India SMS Gateway)
# Get API key from https://2factor.in
TWO_FACTOR_API_KEY=

# Option 4: MSG91 (India)
# Get credentials from https://msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Option 5: Custom Gateway Webhook URL
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=

# Server Configuration
PORT=3000
MONGODB_URI=mongodb://localhost:27017
